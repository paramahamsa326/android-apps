<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:example="http://schemas.android.com/apk/res/com.troden.thezoo">

    <PreferenceCategory 
        android:title="Settings" >
    
        <Preference 
    	    android:title="The Zoo "
    	    android:summary="\u00A9 2015 Vadlamudi and Co Inc\u2122"
    	    android:selectable="false"/>  
    	<Preference 
    	    android:title="Version"
    	    android:summary="@string/app_version"
    	    android:selectable="false"/>

		<Preference
    	    android:title="About The Zoo"
    	    android:summary="Learn more  at http://www.houstonzoo.org/"
    	    android:key="key_company_info" />
        <Preference
            android:title="Share this App"
            android:summary="Please share The Zoo App with your friends and Family"
            android:key="share_the_app" />

    	<CheckBoxPreference 
    	    android:title="Play Background Music"
    	    android:key="prefs_music_enabled"
    	    android:defaultValue="true" />
    	<CheckBoxPreference 
    	    android:title="Play Animal Sound"
    	    android:key="prefs_animalsound_enabled"
    	    android:defaultValue="true" />
 	</PreferenceCategory>	   
</PreferenceScreen>
